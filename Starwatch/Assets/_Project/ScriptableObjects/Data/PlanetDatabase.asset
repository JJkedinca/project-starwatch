%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e8179eceed1a40a39b23277eba2f39ee, type: 3}
  m_Name: PlanetDatabase
  m_EditorClassIdentifier: ProjectStarwatch.Core::ProjectStarwatch.Core.Data.PlanetDatabaseSO
  _planets:
  - _displayName: Temperate World
    _summary: Balanced colony world.
    <Modifiers>k__BackingField:
      _industryMultiplier: 1
      _energyMultiplier: 1
      _scienceMultiplier: 1
      _strategicMultiplier: 1
    _footprintBudget: 10
    _deposits: []
  - _displayName: Industrial World
    _summary: Dense crust and easy extraction.
    <Modifiers>k__BackingField:
      _industryMultiplier: 1.5
      _energyMultiplier: 1
      _scienceMultiplier: 0.9
      _strategicMultiplier: 1
    _footprintBudget: 10
    _deposits: []
  - _displayName: Research World
    _summary: Clear skies and deep archives.
    <Modifiers>k__BackingField:
      _industryMultiplier: 0.9
      _energyMultiplier: 1
      _scienceMultiplier: 1.5
      _strategicMultiplier: 1
    _footprintBudget: 10
    _deposits: []
  - _displayName: Strategic World
    _summary: Rare materials near the surface.
    <Modifiers>k__BackingField:
      _industryMultiplier: 1
      _energyMultiplier: 1
      _scienceMultiplier: 1
      _strategicMultiplier: 1.25
    _footprintBudget: 10
    _deposits:
    - 3
  - _displayName: Barren Rock
    _summary: Thin atmosphere, tight footprint.
    <Modifiers>k__BackingField:
      _industryMultiplier: 0.8
      _energyMultiplier: 1.1
      _scienceMultiplier: 1
      _strategicMultiplier: 1
    _footprintBudget: 6
    _deposits: []
