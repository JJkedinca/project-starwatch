<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Overworld.uss" />
    <ui:VisualElement name="root" class="root">
        <ui:VisualElement name="header" class="header">
            <ui:Label name="title" text="Star Map" class="title" />
            <ui:Label name="status-label" text="" class="status-label" />
        </ui:VisualElement>
        <ui:VisualElement name="content" class="content">
            <ui:VisualElement name="map-surface" class="map-surface" />
            <ui:VisualElement name="inspection-panel" class="inspection-panel">
                <ui:Label name="inspection-title" text="Select a node" class="inspection-title" />
                <ui:Label name="inspection-summary" text="" class="inspection-summary" />
                <ui:Button name="explore-button" text="Explore" class="action-button" />
                <ui:VisualElement name="planet-list" class="planet-list" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
