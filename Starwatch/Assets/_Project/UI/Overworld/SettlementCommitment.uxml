<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Overworld.uss" />
    <ui:VisualElement name="settlement-commitment" class="settlement-commitment hud-panel">
        <ui:Label text="FOUND SETTLEMENT" class="hud-caption" />
        <ui:VisualElement class="settlement-commitment__kinds">
            <ui:Button name="kind-outpost-button" text="Outpost" class="action-button settlement-commitment__kind" />
            <ui:Button name="kind-colony-button" text="Colony" class="action-button settlement-commitment__kind" />
        </ui:VisualElement>
        <ui:Label name="commitment-cost" text="" class="settlement-commitment__cost" />
        <ui:Label name="commitment-escalation" text="" class="settlement-commitment__note" />
        <ui:Label name="commitment-warning" text="" class="settlement-commitment__warn" />
        <ui:Button name="commit-button" text="COMMIT" class="action-button settlement-commitment__commit" />
    </ui:VisualElement>
</ui:UXML>
