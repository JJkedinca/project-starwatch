/*
 * Overworld screen stylesheet.
 * Shared tokens and .hud-* helpers live in UI/Shared/Theme.uss.
 *
 * Stack (UXML sibling order under .root, back → front):
 *   top-bar-slot → content → top-bar (chrome) → toast-stack → (future modal)
 * Unity 6 USS has no z-index; later siblings paint on top.
 *
 * Sections (search for "===="):
 *   1. Screen shell          — root, top bar, content columns, empty fleet hosts
 *   2. Research panel        — right-column overlay from the stockpile entry
 *   3. Stockpile / top bar   — resource readouts, rates, floater, tooltip, research entry
 *   4. Star map surface      — map panel, routes, overlay host for the system scene
 *   5. Star system scene     — orbital view, star glow, header
 *   6. Planet icons          — glyphs, reticles, name plates
 *   7. System fleet dock     — fleets list inside an open system
 *   8. Fleet list & panel    — map/system fleet choices and details panel
 *   9. Shipyard              — settlement shipyard section
 *  10. Right inspection      — target card, planet detail, settlement, buildings
 *  11. Map nodes             — star-map node buttons and fleet pips
 */

@import url("../Shared/Theme.uss");

/* =============================================================================
 * 1. Screen shell
 * Overworld.uxml: root → top-bar → research → content
 *   (fleet-roster-host | center-column | inspection-panel)
 * ============================================================================= */

.root {
    flex-grow: 1;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    /* Transparent so the 3D star map camera shows through the map region. */
    background-color: rgba(0, 0, 0, 0);
    padding: 12px;
    position: relative;
}

/* Reserves vertical space; the real .top-bar is absolute and paints above .content. */
.top-bar-slot {
    flex-shrink: 0;
    min-height: 56px;
    margin-bottom: 8px;
}

.top-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 40px;
    position: absolute;
    left: 12px;
    right: 12px;
    top: 12px;
    overflow: visible;
    background-color: var(--panel-bg-translucent);
    border-width: 1px;
    border-color: var(--panel-border);
    padding: 6px 10px;
}

.title {
    font-size: 22px;
    color: var(--text-primary);
    -unity-font-style: bold;
    margin-right: 16px;
    flex-shrink: 0;
    position: relative;
}

.toast-stack {
    position: absolute;
    bottom: 48px;
    left: 50%;
    translate: -50% 0;
    width: 360px;
    flex-direction: column;
    align-items: stretch;
}

.toast {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    padding: 8px 10px;
    background-color: var(--panel-bg);
    border-width: 1px;
    border-color: var(--panel-border);
}

.toast__accent {
    width: 3px;
    align-self: stretch;
    margin-right: 8px;
    background-color: var(--nav-cyan);
}

.toast--error > .toast__accent {
    background-color: var(--bad-red);
}

.toast--result > .toast__accent {
    background-color: var(--nav-cyan);
}

.toast--event > .toast__accent {
    background-color: var(--text-muted);
}

.toast__label {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 12px;
    color: var(--text-primary);
    white-space: normal;
}

.toast__dismiss {
    margin-left: 8px;
    width: 22px;
    height: 22px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--text-muted);
    font-size: 14px;
    -unity-text-align: middle-center;
}

.content {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: row;
}

.fleet-roster-host {
    width: 220px;
    min-width: 180px;
    flex-shrink: 0;
    margin-right: 12px;
    overflow: hidden;
    background-color: var(--panel-bg-translucent);
    border-width: 1px;
    border-color: var(--panel-border);
    padding: 8px;
}

.center-column {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    margin-right: 12px;
}

.fleet-bar-host {
    flex-shrink: 0;
    min-height: 0;
    overflow: visible;
    background-color: var(--panel-bg-translucent);
    border-width: 1px;
    border-color: var(--panel-border);
    margin-top: 8px;
    padding: 6px 8px;
}

/* =============================================================================
 * 2. Research panel
 * ResearchPanel.uxml — right column overlay; toggled from the stockpile entry.
 * ============================================================================= */

.research-panel {
    display: none;
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    align-items: stretch;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.research-drawer-header {
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.research-offer--dim {
    opacity: 0.45;
}

.stockpile-research--warn {
    color: var(--warn-amber);
}

.research-column {
    flex-direction: column;
    margin-bottom: 12px;
    min-width: 0;
    width: 100%;
}

.research-caption {
    font-size: 11px;
    color: rgb(160, 176, 196);
    margin-bottom: 4px;
}

.research-line {
    font-size: 12px;
    color: rgb(230, 236, 245);
    white-space: normal;
}

.research-offers {
    flex-direction: column;
    flex-wrap: nowrap;
}

.research-offer {
    margin-right: 0;
    margin-bottom: 6px;
    white-space: normal;
    height: auto;
    min-height: 56px;
}

.research-hover {
    display: none;
    min-width: 100%;
    margin-top: 6px;
    font-size: 12px;
    color: rgb(230, 236, 245);
    white-space: normal;
}

.research-confirm {
    display: none;
    flex-direction: row;
    align-items: center;
    min-width: 100%;
    margin-top: 8px;
}

.research-confirm-button {
    margin-left: 8px;
}

/* =============================================================================
 * 3. Stockpile / top bar
 * StockpileBar.uxml + ResourceReadout.uxml — lives inside .top-bar.
 * Rates use Theme .hud-rate--*; floaters are USS transitions from Apply.
 * ============================================================================= */

.stockpile-bar {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    align-items: center;
    min-height: 28px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    position: relative;
    overflow: visible;
}

.stockpile-readouts {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.stockpile-item {
    flex-direction: column;
    align-items: flex-start;
    margin-left: 10px;
    margin-right: 10px;
    position: relative;
}

.stockpile-caption {
    font-size: 10px;
    color: var(--text-muted);
    letter-spacing: 1px;
    margin-bottom: 1px;
}

.stockpile-amount-row {
    flex-direction: row;
    align-items: flex-end;
}

.stockpile-amount {
    font-size: 16px;
    color: var(--text-primary);
    -unity-font-style: bold;
    margin-right: 6px;
}

.stockpile-rate {
    font-size: 12px;
}

.stockpile-chip {
    margin-top: 2px;
    font-size: 9px;
    letter-spacing: 1px;
    color: var(--bad-red);
    display: none;
}

.stockpile-research {
    flex-direction: row;
    align-items: center;
    margin-left: 18px;
    flex-shrink: 0;
}

.stockpile-science {
    flex-direction: column;
    margin-right: 8px;
}

.stockpile-science-rate {
    font-size: 12px;
    color: var(--nav-cyan);
}

.stockpile-research-progress {
    width: 72px;
    height: 6px;
    margin-top: 2px;
    background-color: rgb(28, 38, 54);
}

.stockpile-research-progress-fill {
    height: 100%;
    width: 0;
    background-color: var(--nav-cyan);
}

.stockpile-floater {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 12px;
    color: var(--good-green);
    -unity-font-style: bold;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.8s;
}

.stockpile-floater--fade {
    opacity: 0;
    translate: 0 -18px;
}

.stockpile-tooltip {
    position: absolute;
    display: none;
    left: 0;
    top: 100%;
    margin-top: 6px;
    min-width: 220px;
    max-width: 320px;
    padding: 8px 10px;
    background-color: rgba(12, 18, 28, 0.96);
    border-width: 1px;
    border-color: var(--panel-border);
    border-top-width: 2px;
    border-top-color: var(--nav-cyan);
}

.stockpile-tooltip__line {
    font-size: 11px;
    color: var(--text-primary);
    white-space: normal;
    margin-bottom: 2px;
}

.stockpile-tooltip__muted {
    font-size: 11px;
    color: var(--text-muted);
    white-space: normal;
    margin-bottom: 2px;
}

/* =============================================================================
 * 4. Star map surface
 * Center column: map-panel holds map-surface and the star-system-host overlay.
 * ============================================================================= */

.map-panel {
    flex-grow: 1;
    min-height: 0;
    position: relative;
}

.map-surface {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    overflow: hidden;
}

.map-world-label {
    position: absolute;
    color: rgb(210, 230, 245);
    font-size: 11px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.85);
}

.inspection-travel {
    margin-top: 8px;
    align-self: stretch;
}

.star-system-host {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* =============================================================================
 * 5. Star system scene
 * StarSystemView.uxml — full-bleed orbital scene over the map when a system is open.
 * Corner brackets use Theme .hud-corner.
 * ============================================================================= */

.star-system {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    /* Transparent so the 3D system world shows through; chrome stays opaque. */
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    overflow: hidden;
    display: none;
}

.system-scene,
.system-orbits,
.planet-strip {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.system-star {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
}

.system-star__halo,
.system-star__corona,
.system-star__glow,
.system-star__core {
    position: absolute;
}

.system-star__halo {
    left: -130px;
    top: -130px;
    width: 260px;
    height: 260px;
    border-radius: 130px;
    background-color: rgba(255, 170, 70, 0.05);
}

.system-star__corona {
    left: -85px;
    top: -85px;
    width: 170px;
    height: 170px;
    border-radius: 85px;
    background-color: rgba(255, 185, 90, 0.09);
}

.system-star__glow {
    left: -55px;
    top: -55px;
    width: 110px;
    height: 110px;
    border-radius: 55px;
    background-color: rgba(255, 205, 120, 0.22);
}

.system-star__core {
    left: -32px;
    top: -32px;
    width: 64px;
    height: 64px;
    border-radius: 32px;
    border-width: 3px;
    border-color: var(--star-rim);
    background-color: var(--star-core);
}

.star-system-header {
    position: absolute;
    left: 24px;
    top: 20px;
    flex-direction: row;
    align-items: flex-start;
}

.star-system-back {
    height: 28px;
    margin: 4px 18px 0 0;
    padding: 0 12px;
    border-width: 1px;
    border-radius: 2px;
    border-color: rgba(120, 170, 220, 0.6);
    background-color: rgba(20, 32, 48, 0.85);
    color: rgb(180, 210, 240);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.12s;
}

.star-system-back:hover {
    background-color: rgba(40, 70, 105, 0.95);
    border-color: rgb(150, 200, 245);
    color: rgb(240, 248, 255);
}

.star-system-heading {
    flex-direction: column;
    padding-left: 12px;
    border-left-width: 2px;
    border-left-color: var(--accent-gold);
}

.star-system-caption {
    font-size: 10px;
    color: var(--accent-gold);
    letter-spacing: 3px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

.star-system-title {
    font-size: 26px;
    color: var(--text-primary);
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding: 0;
    margin: 0;
}

.star-system-summary {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 2px;
    padding: 0;
    margin: 2px 0 0 0;
}

/* =============================================================================
 * 6. Planet icons
 * Built by PlanetIconView inside the system scene.
 * ============================================================================= */

.planet-icon {
    position: absolute;
    /* Width, height, and position come from PlanetIconView / SystemOrbitLayout. */
}

.planet-icon__reticle {
    position: absolute;
    border-width: 2px;
    border-color: rgba(240, 200, 90, 0);
    transition-property: border-color, scale;
    transition-duration: 0.15s;
    scale: 1.15 1.15;
}

.planet-icon:hover .planet-icon__reticle {
    border-color: rgba(150, 200, 245, 0.45);
    scale: 1 1;
}

.planet-icon--selected .planet-icon__reticle,
.planet-icon--selected:hover .planet-icon__reticle {
    border-color: var(--accent-gold);
    scale: 1 1;
}

.planet-icon__glyph,
.planet-icon__glyph:hover,
.planet-icon__glyph:active {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.planet-icon__body {
    flex-grow: 1;
    overflow: hidden;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.25);
    transition-property: scale, border-color;
    transition-duration: 0.12s;
}

.planet-icon__glyph:hover .planet-icon__body {
    scale: 1.08 1.08;
    border-color: rgba(255, 255, 255, 0.55);
}

.planet-icon--selected .planet-icon__body {
    border-color: rgb(255, 225, 140);
}

/* Night-side disc. PlanetIconView translates it away from the star. */
.planet-icon__shade {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(4, 6, 12, 0.62);
}

.planet-icon__unknown {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    background-color: rgba(8, 12, 20, 0.55);
    color: rgb(170, 195, 225);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.planet-icon--scanned .planet-icon__unknown {
    display: none;
}

/* Placeholder palette until planets carry an authored archetype. */
.planet-icon--hue-0 .planet-icon__body { background-color: rgb(196, 104, 72); }
.planet-icon--hue-1 .planet-icon__body { background-color: rgb(62, 158, 146); }
.planet-icon--hue-2 .planet-icon__body { background-color: rgb(148, 188, 224); }
.planet-icon--hue-3 .planet-icon__body { background-color: rgb(204, 164, 84); }
.planet-icon--hue-4 .planet-icon__body { background-color: rgb(138, 104, 190); }

.planet-icon__plate {
    position: absolute;
    top: 100%;
    left: -70px;
    right: -70px;
    margin-top: 8px;
    align-items: center;
}

.planet-icon__label {
    padding: 2px 8px;
    margin: 0;
    background-color: rgba(10, 16, 26, 0.8);
    border-left-width: 2px;
    border-left-color: rgba(120, 170, 220, 0.7);
    color: rgb(220, 230, 242);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.planet-icon--selected .planet-icon__label {
    border-left-color: var(--accent-gold);
    color: rgb(255, 240, 205);
}

.planet-icon__tag {
    margin: 2px 0 0 0;
    padding: 0;
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--text-muted);
    -unity-text-align: middle-center;
}

.planet-icon--scanned .planet-icon__tag {
    color: var(--good-green);
}

/* =============================================================================
 * 7. System fleet dock
 * Fleets present in the open system (bottom-left of the orbital scene).
 * ============================================================================= */

.system-fleet-dock {
    position: absolute;
    left: 24px;
    bottom: 22px;
    min-width: 220px;
    padding: 8px 10px 4px 10px;
    background-color: rgba(12, 18, 28, 0.88);
    border-width: 1px;
    border-color: rgba(120, 170, 220, 0.35);
    border-top-width: 2px;
    border-top-color: rgb(120, 170, 220);
    display: none;
}

.system-fleet-dock__caption {
    font-size: 10px;
    color: rgb(120, 170, 220);
    letter-spacing: 3px;
    -unity-font-style: bold;
    margin: 0 0 6px 0;
    padding: 0;
}

.system-fleet-dock .fleet-choice {
    height: 26px;
    margin: 0 0 4px 0;
    padding-left: 10px;
    border-width: 0;
    border-left-width: 3px;
    border-left-color: rgb(120, 170, 220);
    border-radius: 0;
    background-color: rgba(30, 44, 64, 0.9);
    font-size: 12px;
}

.system-fleet-dock .fleet-choice:hover {
    background-color: rgba(48, 70, 100, 0.95);
}

.system-fleet-dock .fleet-choice--selected {
    border-left-color: var(--accent-gold);
    background-color: rgba(70, 60, 30, 0.9);
    color: rgb(255, 240, 205);
}

/* =============================================================================
 * 8. Fleet list & panel
 * Choice rows (map card / system) and FleetPanel.uxml details (split / merge).
 * ============================================================================= */

.fleet-list-caption {
    font-size: 11px;
    color: rgb(160, 176, 196);
    margin-top: 4px;
    margin-bottom: 4px;
}

.fleet-list {
    flex-direction: column;
    flex-shrink: 0;
}

.fleet-choice {
    height: 28px;
    margin-bottom: 4px;
    padding-left: 8px;
    background-color: rgb(28, 38, 54);
    color: rgb(220, 228, 240);
    border-width: 1px;
    border-color: rgb(70, 86, 110);
    -unity-text-align: middle-left;
}

.fleet-choice--selected {
    border-color: var(--accent-gold);
    color: rgb(245, 236, 210);
}

.fleet-roster {
    flex-grow: 1;
    height: 100%;
    flex-direction: column;
    min-height: 0;
}

.fleet-roster-caption {
    margin-bottom: 8px;
}

.fleet-roster-list {
    flex-grow: 1;
    min-height: 0;
}

.fleet-roster-row {
    flex-direction: column;
    align-items: stretch;
    height: auto;
    margin-bottom: 6px;
    padding: 6px 8px;
    border-width: 0;
    border-left-width: 3px;
    border-left-color: var(--nav-cyan);
    border-radius: 0;
    background-color: rgba(30, 44, 64, 0.9);
    -unity-text-align: middle-left;
}

.fleet-roster-row:hover {
    background-color: rgba(48, 70, 100, 0.95);
}

.fleet-roster-row--selected {
    border-left-color: var(--accent-gold);
    background-color: rgba(70, 60, 30, 0.9);
}

.fleet-roster-row__title {
    font-size: 12px;
    color: var(--text-primary);
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.fleet-roster-row__status {
    font-size: 10px;
    color: var(--text-muted);
    letter-spacing: 1px;
    margin: 2px 0 0 0;
    padding: 0;
    white-space: normal;
}

.fleet-roster-row__ships {
    font-size: 11px;
    color: var(--nav-cyan);
    margin: 2px 0 0 0;
    padding: 0;
}

.fleet-bar {
    display: none;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    margin-top: 8px;
}

.fleet-bar-main {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-wrap: wrap;
}

.fleet-bar-name {
    font-size: 14px;
    color: var(--text-primary);
    -unity-font-style: bold;
    margin-right: 12px;
}

.fleet-bar-status {
    font-size: 12px;
    color: var(--text-muted);
    margin-right: 12px;
}

.fleet-bar-ships,
.fleet-bar-speed {
    font-size: 12px;
    color: var(--nav-cyan);
    margin-right: 10px;
}

.fleet-bar-stacks {
    flex-direction: row;
    align-items: center;
}

.fleet-bar-chip {
    margin-right: 6px;
    padding: 2px 6px;
    background-color: rgba(20, 32, 48, 0.9);
    border-width: 1px;
    border-color: var(--panel-border);
    font-size: 11px;
    color: var(--text-primary);
}

.fleet-bar-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.fleet-bar-details {
    height: 28px;
    margin-right: 6px;
    margin-bottom: 0;
    background-color: rgb(48, 96, 160);
    color: rgb(245, 248, 252);
}

.fleet-bar-close {
    width: 28px;
    height: 28px;
    margin-bottom: 0;
    background-color: rgb(48, 96, 160);
    color: rgb(245, 248, 252);
}

.fleet-panel {
    display: none;
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.fleet-panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.fleet-panel-title {
    font-size: 16px;
    color: rgb(230, 236, 245);
    -unity-font-style: bold;
}

.fleet-panel-close {
    width: 64px;
    height: 24px;
    margin-bottom: 0;
    background-color: rgb(48, 96, 160);
    color: rgb(245, 248, 252);
}

.fleet-panel-status,
.fleet-panel-speed {
    font-size: 12px;
    color: rgb(180, 192, 210);
    margin-bottom: 4px;
}

.fleet-panel-stacks {
    flex-direction: column;
}

.fleet-stack {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 2px;
}

.fleet-stack-name {
    font-size: 13px;
    color: rgb(230, 236, 245);
}

.fleet-stack-detail {
    font-size: 12px;
    color: rgb(160, 176, 196);
}

.fleet-split-count {
    width: 48px;
    margin-left: 6px;
}

.fleet-split,
.fleet-merge {
    height: 24px;
    margin-left: 6px;
    margin-bottom: 0;
    background-color: rgb(48, 96, 160);
    color: rgb(245, 248, 252);
}

/* =============================================================================
 * 9. Shipyard
 * ShipyardSection.uxml inside the settlement scroll view.
 * ============================================================================= */

.shipyard-section {
    display: none;
    flex-direction: column;
    margin-top: 8px;
}

.shipyard-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
}

.shipyard-row-name {
    flex-grow: 1;
    font-size: 12px;
    color: rgb(220, 228, 240);
    white-space: normal;
}

.shipyard-build,
.shipyard-cancel {
    width: 64px;
    height: 24px;
    margin-left: 6px;
    margin-bottom: 0;
    background-color: rgb(48, 96, 160);
    color: rgb(245, 248, 252);
}

.shipyard-progress {
    width: 48px;
    height: 8px;
    margin-left: 6px;
    background-color: rgb(28, 38, 54);
}

.shipyard-progress-fill {
    height: 100%;
    background-color: rgb(90, 160, 210);
}

/* =============================================================================
 * 10. Right inspection column
 * Target card (map), settlement dossier (system), or research / fleet overlay.
 * ============================================================================= */

.inspection-panel {
    width: 320px;
    flex-shrink: 0;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    position: relative;
    background-color: var(--panel-bg-translucent);
    border-width: 1px;
    border-color: var(--panel-border);
    padding: 12px;
}

.star-system-inspection {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
}

.inspection-caption {
    margin-bottom: 6px;
}

.inspection-title {
    font-size: 18px;
    color: var(--accent-gold);
    margin-bottom: 8px;
    -unity-font-style: bold;
}

.inspection-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.inspection-chip {
    margin-right: 6px;
    margin-bottom: 4px;
}

.inspection-chip--good {
    color: var(--good-green);
}

.inspection-chip--muted {
    color: var(--text-muted);
}

.inspection-chip--info {
    color: var(--nav-cyan);
}

.inspection-info {
    white-space: normal;
    color: var(--text-muted);
    font-size: 12px;
    margin-bottom: 4px;
}

.inspection-relation {
    white-space: normal;
    color: var(--nav-cyan);
    font-size: 13px;
    margin-top: 8px;
    margin-bottom: 4px;
}

.inspection-hint {
    white-space: normal;
    color: var(--accent-gold);
    font-size: 12px;
    margin-top: 4px;
}

.map-hover-tooltip {
    position: absolute;
    padding: 4px 8px;
    background-color: rgba(12, 18, 28, 0.92);
    border-width: 1px;
    border-color: var(--panel-border);
    color: var(--text-primary);
    font-size: 11px;
}

.action-button {
    height: 32px;
    margin-bottom: 8px;
    background-color: rgb(48, 96, 160);
    color: rgb(245, 248, 252);
}

.action-button:disabled {
    background-color: rgb(36, 44, 58);
    color: rgb(120, 130, 145);
}

.travel-arrival {
    font-size: 12px;
    color: rgb(180, 192, 210);
    margin-bottom: 8px;
}

.settlement-panel {
    display: none;
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-top: 0;
    padding-top: 0;
    border-top-width: 0;
    border-top-color: rgb(40, 52, 70);
}

.settlement-header {
    flex-shrink: 0;
    margin-bottom: 8px;
}

.settlement-header__top {
    flex-direction: row;
    align-items: center;
}

.settlement-planet-name {
    flex-grow: 1;
    font-size: 16px;
    color: var(--accent-gold);
    -unity-font-style: bold;
}

.settlement-scan,
.settlement-abandon,
.settlement-abandon-confirm {
    margin-left: 8px;
}

.settlement-abandon-confirm {
    display: none;
}

.settlement-presence,
.settlement-footprint {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 2px;
}

.settlement-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.settlement-tabs {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.settlement-tab {
    margin-right: 6px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    color: var(--text-muted);
    font-size: 11px;
    letter-spacing: 1px;
}

.settlement-tab--selected {
    color: var(--nav-cyan);
    border-bottom-color: var(--nav-cyan);
}

.settlement-body {
    flex-grow: 1;
    min-height: 0;
}

.settlement-net-line {
    font-size: 12px;
    color: var(--text-primary);
    margin-bottom: 8px;
    white-space: normal;
}

.settlement-commitment__kinds {
    flex-direction: row;
    margin-top: 6px;
    margin-bottom: 6px;
}

.settlement-commitment__kind {
    margin-right: 6px;
}

.settlement-commitment__kind--selected {
    border-color: var(--accent-gold);
}

.settlement-commitment__cost {
    font-size: 13px;
    color: var(--text-primary);
}

.settlement-commitment__note {
    font-size: 11px;
    color: var(--text-muted);
}

.settlement-commitment__warn {
    font-size: 11px;
    color: var(--warn-amber);
}

.settlement-commitment__commit {
    margin-top: 8px;
}

.planet-figures {
    flex-direction: row;
    align-items: flex-start;
}

.resource-panel {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 12px;
    margin-bottom: 8px;
}

.resource-panel-title {
    color: rgb(220, 228, 240);
    font-size: 13px;
    margin-bottom: 4px;
    -unity-font-style: bold;
}

.resource-summary {
    margin-bottom: 8px;
}

.resource-line {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 2px;
}

.resource-caption {
    color: rgb(160, 176, 196);
    font-size: 12px;
}

.resource-amount {
    color: rgb(230, 236, 245);
    font-size: 12px;
    -unity-font-style: bold;
}

.planet-development,
.colony-status,
.settlement-commitment {
    margin-top: 8px;
}

.settlement-summary {
    white-space: normal;
    color: rgb(180, 192, 210);
    font-size: 12px;
}

.building-list {
    margin-top: 8px;
}

.building-row {
    margin-bottom: 8px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(40, 52, 70);
}

.building-label {
    white-space: normal;
    color: rgb(200, 210, 225);
    font-size: 12px;
    margin-bottom: 4px;
}

.building-row .action-button {
    font-size: 11px;
}

