.root {
    flex-grow: 1;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    background-color: rgb(10, 14, 20);
    padding: 12px;
}

.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.title {
    font-size: 28px;
    color: rgb(230, 236, 245);
    -unity-font-style: bold;
}

.status-label {
    font-size: 14px;
    color: rgb(160, 176, 196);
}

.content {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: row;
}

.research-panel {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    flex-shrink: 0;
    margin-bottom: 8px;
    padding: 8px;
    background-color: rgb(16, 22, 32);
    border-width: 1px;
    border-color: rgb(40, 52, 70);
}

.research-column {
    flex-direction: column;
    margin-right: 18px;
    min-width: 180px;
}

.research-caption {
    font-size: 11px;
    color: rgb(160, 176, 196);
    margin-bottom: 4px;
}

.research-line {
    font-size: 12px;
    color: rgb(230, 236, 245);
    white-space: normal;
}

.research-offers {
    flex-direction: row;
    flex-wrap: wrap;
}

.research-offer {
    margin-right: 6px;
    margin-bottom: 4px;
}

.research-hover {
    display: none;
    min-width: 100%;
    margin-top: 6px;
    font-size: 12px;
    color: rgb(230, 236, 245);
    white-space: normal;
}

.research-confirm {
    display: none;
    flex-direction: row;
    align-items: center;
    min-width: 100%;
    margin-top: 8px;
}

.research-confirm-button {
    margin-left: 8px;
}

.stockpile-bar {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
    min-height: 28px;
    margin-top: 8px;
    background-color: rgb(16, 22, 32);
    border-width: 1px;
    border-color: rgb(40, 52, 70);
}

.stockpile-item {
    flex-direction: row;
    align-items: center;
    margin-left: 14px;
    margin-right: 14px;
}

.stockpile-caption {
    font-size: 11px;
    color: rgb(160, 176, 196);
    margin-right: 6px;
}

.stockpile-amount {
    font-size: 12px;
    color: rgb(230, 236, 245);
    -unity-font-style: bold;
}

.stockpile-research {
    margin-left: 18px;
}

.map-panel {
    flex-grow: 1;
    min-height: 0;
    position: relative;
    margin-right: 12px;
}

.map-surface {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(16, 22, 32);
    border-width: 1px;
    border-color: rgb(40, 52, 70);
    overflow: hidden;
}

.map-route-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.map-route {
    position: absolute;
    /* Stroke width and color come from MapLayout so they stay with node size. */
}

.star-system-host {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.star-system {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    background-color: rgb(14, 20, 30);
    border-width: 1px;
    border-color: rgb(40, 52, 70);
    padding: 16px;
    display: none;
}

.star-system-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 24px;
}

.star-system-back {
    width: 120px;
    margin-right: 16px;
    margin-bottom: 0;
}

.star-system-title {
    font-size: 22px;
    color: rgb(230, 236, 245);
    -unity-font-style: bold;
}

.planet-strip {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.planet-icon {
    align-items: center;
    margin-left: 16px;
    margin-right: 16px;
}

.planet-icon__glyph {
    width: 72px;
    height: 72px;
    border-radius: 36px;
    border-width: 3px;
    border-color: rgb(90, 110, 140);
    background-color: rgb(48, 62, 84);
    margin-bottom: 8px;
}

.planet-icon__glyph--scanned {
    background-color: rgb(70, 110, 150);
    border-color: rgb(140, 180, 220);
}

.planet-icon__glyph--selected,
.planet-icon--selected .planet-icon__glyph {
    border-color: rgb(240, 200, 90);
}

.planet-icon__label {
    color: rgb(200, 210, 225);
    font-size: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 96px;
}

.inspection-panel {
    width: 320px;
    flex-shrink: 0;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    background-color: rgb(18, 24, 34);
    border-width: 1px;
    border-color: rgb(40, 52, 70);
    padding: 12px;
}

.inspection-title {
    font-size: 18px;
    color: rgb(230, 236, 245);
    margin-bottom: 8px;
    -unity-font-style: bold;
}

.inspection-summary {
    white-space: normal;
    color: rgb(180, 192, 210);
    margin-bottom: 12px;
}

.action-button {
    height: 32px;
    margin-bottom: 8px;
    background-color: rgb(48, 96, 160);
    color: rgb(245, 248, 252);
}

.action-button:disabled {
    background-color: rgb(36, 44, 58);
    color: rgb(120, 130, 145);
}

.planet-detail {
    margin-top: 12px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgb(40, 52, 70);
    display: none;
}

.planet-detail-name {
    color: rgb(220, 228, 240);
    font-size: 16px;
    margin-bottom: 6px;
    -unity-font-style: bold;
}

.planet-detail-summary {
    white-space: normal;
    color: rgb(150, 164, 184);
    font-size: 12px;
    margin-bottom: 8px;
}

.settlement-panel {
    display: none;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-top: 12px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgb(40, 52, 70);
}

.planet-figures {
    flex-direction: row;
    align-items: flex-start;
}

.resource-panel {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 12px;
    margin-bottom: 8px;
}

.resource-panel-title {
    color: rgb(220, 228, 240);
    font-size: 13px;
    margin-bottom: 4px;
    -unity-font-style: bold;
}

.resource-summary {
    margin-bottom: 8px;
}

.resource-line {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 2px;
}

.resource-caption {
    color: rgb(160, 176, 196);
    font-size: 12px;
}

.resource-amount {
    color: rgb(230, 236, 245);
    font-size: 12px;
    -unity-font-style: bold;
}

.planet-development,
.colony-status,
.settlement-commitment {
    margin-top: 8px;
}

.settlement-summary {
    white-space: normal;
    color: rgb(180, 192, 210);
    font-size: 12px;
}

.building-list {
    margin-top: 8px;
}

.building-row {
    margin-bottom: 8px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(40, 52, 70);
}

.building-label {
    white-space: normal;
    color: rgb(200, 210, 225);
    font-size: 12px;
    margin-bottom: 4px;
}

.building-row .action-button {
    font-size: 11px;
}

.map-node {
    position: absolute;
    /* Width, height, and non-system radius come from MapLayout.kNodeSize. */
    /* Keep border-width fixed; changing it on select shifts absolute layout. */
    border-width: 3px;
    border-color: rgb(70, 88, 112);
    background-color: rgb(42, 54, 72);
    justify-content: center;
    align-items: center;
    -unity-text-align: middle-center;
    color: rgb(220, 228, 240);
    font-size: 10px;
    white-space: normal;
}

.map-node--system {
    border-radius: 8px;
}

.map-node--hidden {
    background-color: rgb(28, 34, 44);
    border-color: rgb(48, 56, 68);
    color: rgba(0, 0, 0, 0);
}

.map-node--explorable {
    border-color: rgb(120, 170, 220);
    background-color: rgb(36, 48, 66);
}

.map-node--hidden.map-node--explorable {
    color: rgb(180, 200, 220);
}

.map-node--explored {
    background-color: rgb(52, 78, 108);
    border-color: rgb(110, 150, 190);
}

.map-node--present {
    background-color: rgb(56, 110, 74);
    border-color: rgb(140, 210, 150);
}

.map-node--selected {
    border-color: rgb(240, 200, 90);
}

.map-node__orbit {
    position: absolute;
    display: none;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
}

.map-node__orbit--visible {
    display: flex;
    border-color: rgb(240, 210, 80);
}

.map-node__orbit--traveling {
    border-color: rgb(240, 140, 60);
}

.map-node__fleet {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0);
}

.map-node__fleet--visible {
    background-color: rgb(240, 210, 80);
}

.map-node__fleet--traveling {
    background-color: rgb(240, 140, 60);
}
