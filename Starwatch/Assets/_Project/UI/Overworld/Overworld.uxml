<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Overworld.uss" />
    <ui:Template name="StarSystemView" src="StarSystemView.uxml" />
    <ui:Template name="StarSystemInspection" src="StarSystemInspection.uxml" />
    <ui:Template name="PlanetInspection" src="PlanetInspection.uxml" />
    <ui:Template name="ResourceSummary" src="ResourceSummary.uxml" />
    <ui:Template name="PlanetDevelopment" src="PlanetDevelopment.uxml" />
    <ui:Template name="ColonyStatus" src="ColonyStatus.uxml" />
    <ui:Template name="SettlementCommitment" src="SettlementCommitment.uxml" />
    <ui:Template name="BuildingList" src="BuildingList.uxml" />
    <ui:Template name="StockpileBar" src="StockpileBar.uxml" />
    <ui:VisualElement name="root" class="root">
        <ui:VisualElement name="header" class="header">
            <ui:Label name="title" text="Star Map" class="title" />
            <ui:Label name="status-label" text="" class="status-label" />
        </ui:VisualElement>
        <ui:VisualElement name="content" class="content">
            <ui:VisualElement name="map-panel" class="map-panel">
                <ui:VisualElement name="map-surface" class="map-surface" />
                <ui:Instance template="StarSystemView" class="star-system-host" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="inspection-panel" class="inspection-panel">
                <ui:Instance template="StarSystemInspection" />
                <ui:Instance template="PlanetInspection" />
                <ui:ScrollView name="settlement-panel" class="settlement-panel" mode="Vertical" vertical-scroller-visibility="AlwaysVisible">
                    <ui:VisualElement name="planet-figures" class="planet-figures">
                        <ui:VisualElement name="planet-base" class="resource-panel">
                            <ui:Label text="Base" class="resource-panel-title" />
                            <ui:Instance template="ResourceSummary" />
                        </ui:VisualElement>
                        <ui:VisualElement name="planet-production" class="resource-panel">
                            <ui:Label text="Production" class="resource-panel-title" />
                            <ui:Instance template="ResourceSummary" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Instance template="PlanetDevelopment" />
                    <ui:Instance template="ColonyStatus" />
                    <ui:Instance template="SettlementCommitment" />
                    <ui:Instance template="BuildingList" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Instance template="StockpileBar" />
    </ui:VisualElement>
</ui:UXML>
